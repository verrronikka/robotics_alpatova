<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="wheelbase" value="0.8"/>
  <xacro:property name="track" value="0.62"/>
  <xacro:property name="wheel_radius" value="0.12"/>
  <xacro:property name="wheel_width" value="0.07"/>
  <xacro:property name="wheel_mass" value="0.8"/>

  <xacro:macro name="wheel" params="name parent x y">
    <link name="${name}">
      <visual>
        <origin rpy="${pi / 2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black">
          <color rgba="0.04 0.04 0.04 1"/>
        </material>
      </visual>
      <collision>
        <origin rpy="${pi / 2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${wheel_mass * (3 * wheel_radius**2 + wheel_width**2) / 12}"
          iyy="${wheel_mass * wheel_radius**2 / 2}"
          izz="${wheel_mass * (3 * wheel_radius**2 + wheel_width**2) / 12}"
          ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="front_corner" params="side y">
    <link name="front_${side}_knuckle">
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.001" iyy="0.001" izz="0.001"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="front_${side}_steering_joint" type="revolute">
      <parent link="base_link"/>
      <child link="front_${side}_knuckle"/>
      <origin xyz="${wheelbase / 2} ${y} 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.55" upper="0.55" effort="25" velocity="1.0"/>
    </joint>
    <xacro:wheel name="front_${side}_wheel"
                 parent="front_${side}_knuckle" x="0" y="0"/>
  </xacro:macro>

  <xacro:front_corner side="left" y="${track / 2}"/>
  <xacro:front_corner side="right" y="${-track / 2}"/>

  <xacro:wheel name="rear_left_wheel" parent="base_link"
               x="${-wheelbase / 2}" y="${track / 2}"/>
  <xacro:wheel name="rear_right_wheel" parent="base_link"
               x="${-wheelbase / 2}" y="${-track / 2}"/>

</robot>
